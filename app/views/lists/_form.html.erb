<%= simple_form_for(list) do |f| %>
  <%= f.input :name, placeholder: "ex : Action Movies" %>
  <%= f.input :image_url, label: "Image URL", placeholder: "ex : https://image.tmdb.org/t/p/w500/….jpg" %>
  <div class="d-flex gap-2">
    <%= f.submit "Submit", class: "btn btn-primary" %>
    <%= link_to "Cancel", lists_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>
