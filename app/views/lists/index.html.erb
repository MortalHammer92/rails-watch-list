<!-- app/views/lists/index.html.erb -->
<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Lists (<%= @lists.count %>)</h1>
    <%= link_to "Create a list", new_list_path, class: "btn btn-primary" %>
  </div>

  <% if @lists.empty? %>
    <p class="text-muted">No list for now.</p>
  <% end %>

  <div class="row g-4">
    <% @lists.each do |list| %>
      <div class="col-12 col-md-6 col-lg-4">
        <%= link_to list_path(list), class: "text-decoration-none" do %>
          <div class="list-card" style="background-image: linear-gradient(rgba(0,0,0,0.4), rgba(0,0,0,0.4)), url('<%= list.cover_image %>');">
            <h2><%= list.name %></h2>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
