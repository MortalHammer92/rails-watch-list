<!-- app/views/lists/index.html.erb -->
<div class="home-banner mb-5">
  <h1>Save any kind of movies</h1>
  <p>Build your watch lists, one movie at a time.</p>
  <%= link_to "Create a list", new_list_path, class: "btn btn-primary btn-lg" %>
</div>

<div class="container py-4">
  <div class="row">

    <!-- COLONNE GAUCHE : tes listes, rien de changé dedans -->
    <div class="col-md-9">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0">Lists (<%= @lists.count %>)</h1>
        <%= link_to "Create a list", new_list_path, class: "btn btn-primary" %>
      </div>

      <% if @lists.empty? %>
        <p class="text-muted">No list for now.</p>
      <% end %>

      <div class="row g-4">
        <% @lists.each do |list| %>
          <div class="col-12 col-md-6 col-lg-4">
            <%= link_to list_path(list), class: "text-decoration-none" do %>
              <div class="list-card" style="background-image: linear-gradient(rgba(0,0,0,0.4), rgba(0,0,0,0.4)), url('<%= list.cover_image %>');">
                <h2><%= list.name %></h2>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

    <!-- COLONNE DROITE : les films pas encore rangés -->
    <div class="col-md-3">
      <h5>Not in Lists</h5>
      <ul class="list-group">
        <% @unlisted_movies.each do |movie| %>
          <li class="list-group-item">
            <%= link_to movie.title, movie_path(movie), class: "text-decoration-none" %>
          </li>
        <% end %>
      </ul>
    </div>

  </div>
</div>
