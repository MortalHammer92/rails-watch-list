<!-- app/views/lists/index.html.erb -->
<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Lists (<%= @lists.count %>)</h1>
    <%= link_to "Create a list", new_list_path, class: "btn btn-primary" %>
  </div>

  <% if @lists.empty? %>
    <p class="text-muted">No list for now.</p>
  <% end %>

  <div class="row g-3">
    <% @lists.each do |list| %>
      <div class="col-md-4">
        <div class="card p-3 h-100">
          <h5><%= list.name %></h5>
          <%= link_to "See", list_path(list), class: "btn btn-outline-primary btn-sm" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
