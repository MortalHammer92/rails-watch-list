<h1><%= @list.name %></h1>

<% @list.bookmarks.each do |bookmark| %>
  <p>
    <%= bookmark.movie.title %> — <%= bookmark.comment %>
    <%= link_to "delete", bookmark_path(bookmark),
          data: { turbo_method: :delete, turbo_confirm: "Remove this movie from the list?" },
          class: "text-danger ms-2" %>
  </p>
<% end %>

<%= link_to "Back to lists", lists_path, class: "btn btn-outline-secondary" %>
<div class="d-flex gap-2">
  <%= link_to "Add a movie", new_list_bookmark_path(@list), class: "btn btn-primary" %>
  <%= link_to "Back to lists", lists_path, class: "btn btn-outline-secondary" %>
</div>
