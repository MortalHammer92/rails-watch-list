<div class="list-banner mb-4"
     style="background-image: linear-gradient(rgba(0,0,0,0.4), rgba(0,0,0,0.4)), url('<%= @list.cover_image %>');">
  <h1><%= @list.name %></h1>
  <span class="badge text-bg-warning list-banner-count"><%= pluralize(@list.bookmarks.count, "movie") %></span>
</div>

<div class="row g-4 mb-4">
  <% @list.bookmarks.each do |bookmark| %>
    <div class="col-12 col-md-6 col-lg-4">
      <div class="card h-100 shadow-sm">
        <%= image_tag bookmark.movie.poster_url, class: "card-img-top", alt: bookmark.movie.title,
              style: "height: 350px; object-fit: cover;" %>
        <div class="card-body d-flex flex-column">
          <h5 class="card-title mb-1">
            <%= bookmark.movie.title %>
            <span class="text-muted small">· <%= bookmark.movie.rating %> ★</span>
          </h5>
          <p class="card-text text-muted small"><%= truncate(bookmark.movie.overview, length: 150) %></p>
          <div class="d-flex justify-content-between align-items-center mt-auto pt-2 border-top">
            <span class="small">“ <%= bookmark.comment %></span>
            <%= link_to "delete", bookmark_path(bookmark),
                  data: { turbo_method: :delete, turbo_confirm: "Remove this movie from the list?" },
                  class: "text-danger small" %>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>

<div class="card shadow-sm mb-4">
  <div class="card-body">
    <h2 class="h5 mb-3">Add a movie</h2>
    <%= simple_form_for [@list, @bookmark] do |f| %>
      <%= f.association :movie, prompt: "Pick a movie" %>
      <%= f.input :comment, placeholder: "ex : Awesome movie !" %>
      <%= f.submit "Add", class: "btn btn-primary" %>
    <% end %>
  </div>
</div>

<div class="d-flex gap-2">
  <%= link_to "Back to lists", lists_path, class: "btn btn-outline-secondary" %>
  <%= link_to "Edit", edit_list_path(@list), class: "btn btn-outline-primary" %>
  <%= link_to "Delete", list_path(@list),
        data: { turbo_method: :delete, turbo_confirm: "Delete this list and all its movies?" },
        class: "btn btn-outline-danger" %>
</div>
