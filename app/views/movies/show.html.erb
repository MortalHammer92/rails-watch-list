<div class="row">
  <div class="col-md-4">
    <%= image_tag @movie.poster_url, class: "img-fluid rounded shadow" %>
  </div>

  <div class="col-md-8">
    <h1><%= @movie.title %></h1>
    <p>
      <i class="fa-solid fa-star text-warning"></i>
      <%= @movie.rating %> / 10
    </p>
    <p><%= @movie.overview %></p>

    <%= simple_form_for [@movie, @bookmark] do |f| %>
      <%= f.association :list, prompt: "Choose a list" %>
      <%= f.input :comment %>
      <%= f.submit "Add to list", class: "btn btn-primary" %>
    <% end %>

    <%= link_to "Back", root_path, class: "btn btn-outline-secondary mt-3" %>
  </div>
</div>
